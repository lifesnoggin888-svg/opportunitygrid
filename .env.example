# All values below are empty placeholders. Never commit real values to this file.

# Live source-adapter integration (optional). When unset, OpportunityGrid
# runs entirely in DEMO_MODE with no live network calls. Read server-side
# only — see lib/adapters/serpApiAdapter.ts.
SERPAPI_KEY=

# Supabase. When unset, the app runs fully in DEMO_MODE (localStorage only,
# no accounts). NEXT_PUBLIC_* values are safe to expose to the browser —
# they're the anon/publishable key, not a secret. SUPABASE_SERVICE_ROLE_KEY
# must never be prefixed NEXT_PUBLIC_ and is read only from server-side
# route handlers (see lib/supabase/server.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
